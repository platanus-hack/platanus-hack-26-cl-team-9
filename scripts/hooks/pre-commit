#!/usr/bin/env bash
# Git pre-commit hook. Enable once per clone:
#   git config core.hooksPath scripts/hooks
#
# 1. Lints staged files with scripts/lint.sh --check (ruff for Python, eslint/prettier for frontend).
#    It checks the working-tree copy of each staged file.
# 2. Requires CHANGELOG.md to be staged, so every commit tells agents what changed.
#    Skipped for merge commits. For an exceptional commit with no entry:
#    SKIP_CHANGELOG=1 git commit ...   (say why in the commit message)
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --git-dir)"
fail=0

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

if ((${#staged[@]})); then
  abs=()
  for f in "${staged[@]}"; do abs+=("$ROOT/$f"); done
  if ! "$ROOT/scripts/lint.sh" --check "${abs[@]}"; then
    echo "" >&2
    echo "pre-commit: lint failed. Fix with: scripts/lint.sh --fix <files>, then git add them again." >&2
    fail=1
  fi
fi

if [[ "${SKIP_CHANGELOG:-0}" != "1" && ! -f "$GIT_DIR/MERGE_HEAD" ]]; then
  if ! printf '%s\n' "${staged[@]}" | grep -qx 'CHANGELOG.md'; then
    echo "" >&2
    echo "pre-commit: CHANGELOG.md is not staged." >&2
    echo "  Add an entry at the top of CHANGELOG.md (format in AGENTS.md section 3) and git add it." >&2
    fail=1
  fi
fi

exit $fail
