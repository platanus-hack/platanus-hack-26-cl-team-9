# Copy to terraform.tfvars (git-ignored) to override defaults. image_tag is set by deploy.sh.

# Public domain served by CloudFront. Needs an ACM certificate in us-east-1.
# domain_name                = "cascadasen.example.com"
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:402909940511:certificate/..."

# HTTPS between CloudFront and the ALB. Needs an ACM certificate for the ALB.
# origin_https        = true
# alb_certificate_arn = "arn:aws:acm:us-east-1:402909940511:certificate/..."
