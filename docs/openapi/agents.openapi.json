{
  "openapi": "3.1.0",
  "info": {
    "title": "Sub50 agent API",
    "description": "Endpoints an external agent needs to run strategic experiments on Sub50, a simulator of\nblackouts in the Chilean national grid (SEN). Public base URL: `https://sub50.cl`.\n\n**Ids.** The network has buses `B###` and lines `R###` (`GET /api/v1/sim/network`). Event targets\nalso accept an area (`A06`), a zone (`NG`), a corridor (`A06-A07/500`), a defence function\n(`pdce_zn`) or a real substation id (`SE...`). Event types, policies, objectives and templates come\nfrom `GET /api/v1/sim/catalog`. A run is identified by the `run_id` returned on creation.\n\n**Runs.** Runs in `global-runs` work on the default dataset and live in server memory: the most\nrecent 100 are kept and any run can be rebuilt from its recipe (`GET .../trace`). Session\nendpoints (tags `sessions`, `session-network`, `session-sandbox`, `session-runs`) carry the\nsession id in the path and work on that session's private copy of the dataset; create a session\nfirst and pass its id to every session call.\n\n**Notice.** Every scenario is hypothetical and simulated: Sub50 models the consequence of an\nevent on the grid, never the attack technique. The catalog and every run summary carry a\n`notice` field saying so.\n\nErrors return `{\"detail\": ...}`; messages inside `detail` are in Spanish.\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/sim/network": {
      "get": {
        "tags": [
          "global-runs"
        ],
        "summary": "Read the default 188-bus network with its areas, corridors and defences",
        "description": "Returns the mapa 3 network of the default dataset at one operating point: `nodes` (buses `B###` with their `area`), `lines` (`R###` with their `corridor`), `buses` (generation, load, people), `areas`, `corridors` and `defenses`. Call it before creating a run or injecting an event to pick valid targets. Read only.",
        "operationId": "global_get_network",
        "parameters": [
          {
            "name": "point",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Operating point id; omitted means the reference point. Valid ids are in the 404 body.",
              "examples": [
                "nov2026-1300"
              ],
              "title": "Point"
            },
            "description": "Operating point id; omitted means the reference point. Valid ids are in the 404 body."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Global Get Network"
                }
              }
            }
          },
          "404": {
            "description": "Unknown operating point; `detail.valid` lists the valid ones.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/catalog": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List event types, actions, policies, objectives and experiment templates",
        "description": "Returns every choice an agent can make: `events` (type ids for `inject_run_event` and the target kinds they accept), defensive `actions`, `policies` A/B/C, adversary `objectives`, missions and experiment `templates`. Call it once before creating runs. Read only.",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Catalog"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs": {
      "post": {
        "tags": [
          "global-runs"
        ],
        "summary": "Create a strategic run over the default dataset",
        "description": "Creates a run of the strategic theatre from a template (`GET /api/v1/sim/catalog` → `templates`) with a policy, an optional adversary, uncertainty, seed and initial events. Returns the run summary with its `run_id`, used by every other run call. With `auto_run` the run is played to the end before returning. The run lives in server memory.",
        "operationId": "global_create_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown template or event target.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input (policy, operating point, horizon, adversary, capabilities, event type).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs/{run_id}": {
      "get": {
        "tags": [
          "global-runs"
        ],
        "summary": "Read a run's latest state",
        "description": "Returns the run summary, the latest cycle snapshot (real, observed and per-agent estimated state, decisions, grid frame, areas, crews, metrics), the resource ledger and the metric series of every cycle so far. Read only.",
        "operationId": "global_get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)",
              "examples": [
                "3f2a9c1b7d4e"
              ],
              "title": "Run Id"
            },
            "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Global Get Run"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid path parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs/{run_id}/events": {
      "post": {
        "tags": [
          "global-runs"
        ],
        "summary": "Trigger an event on a target; it applies at the next cycle",
        "description": "Queues an event (`type` from `GET /api/v1/sim/catalog` → `events`) on a target: area, zone, corridor, bus `B###`, line `R###`, defence function or real substation id `SE...`. The response echoes `resolved_target` and `area`. The event is logged with `source: user` and takes effect when the run is stepped.",
        "operationId": "global_inject_run_event",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)",
              "examples": [
                "3f2a9c1b7d4e"
              ],
              "title": "Run Id"
            },
            "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Global Inject Run Event"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run_id or target.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The run has finished; replay it instead.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid event type or body.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs/{run_id}/step": {
      "post": {
        "tags": [
          "global-runs"
        ],
        "summary": "Advance a run by n cycles of 5 minutes",
        "description": "Runs `cycles` cycles (1 to 72) and returns one snapshot per cycle. Queued events apply in the first one. A finished run returns no new snapshots.",
        "operationId": "global_step_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)",
              "examples": [
                "3f2a9c1b7d4e"
              ],
              "title": "Run Id"
            },
            "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StepIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Global Step Run"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`cycles` outside 1-72.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs/{run_id}/replay": {
      "post": {
        "tags": [
          "global-runs"
        ],
        "summary": "Replay a run with the same seed and events, optionally changing policy or capabilities",
        "description": "Creates a new run from the original's recipe: same seed and the same user events, re-injected at their cycles, with the given overrides. It plays as many cycles as the original (or `cycles`). An unchanged replay gives the same trace hash. Returns the new run summary with `replay_of` and `overrides`.",
        "operationId": "global_replay_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)",
              "examples": [
                "3f2a9c1b7d4e"
              ],
              "title": "Run Id"
            },
            "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplayIn"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunSummary"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid override.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
    "/api/v1/sim/runs/{run_id}/snapshots": {
      "get": {
        "tags": [
          "global-runs"
        ],
        "summary": "Read the snapshots already computed from a cycle on",
        "description": "Returns the run summary and the cycle snapshots from index `start`. Use it to read a replay, which computes all its cycles at once. Read only.",
        "operationId": "global_get_run_snapshots",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)",
              "examples": [
                "3f2a9c1b7d4e"
              ],
              "title": "Run Id"
            },
            "description": "Run id returned by `POST /api/v1/sim/runs` or `/replay` (12 hex characters)"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "description": "First cycle index to return (0-based)",
              "examples": [
                0
              ],
              "default": 0,
              "title": "Start"
            },
            "description": "First cycle index to return (0-based)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Global Get Run Snapshots"
                }
              }
            }
          },
          "404": {
            "description": "Unknown run_id.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`start` is not an integer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "x-sub50-agent": true
      }
    },
