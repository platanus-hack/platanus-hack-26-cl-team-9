  "components": {
    "schemas": {
      "AdversaryIn": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "description": "Whether the adversary plays",
            "default": true,
            "examples": [
              true
            ]
          },
          "objective": {
            "type": "string",
            "title": "Objective",
            "description": "Adversary objective; see `GET /api/v1/sim/catalog` → `objectives`",
            "default": "reduce_observability",
            "examples": [
              "reduce_observability"
            ]
          },
          "budget": {
            "type": "number",
            "title": "Budget",
            "description": "Adversary actions, 0 to 50 (digital action = 1, physical = 2)",
            "default": 8,
            "examples": [
              8
            ]
          },
          "adaptive": {
            "type": "boolean",
            "title": "Adaptive",
            "description": "True: it learns during the run (EXP3); False: it plays the template's plan",
            "default": true,
            "examples": [
              true
            ]
          }
        },
        "type": "object",
        "title": "AdversaryIn"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              }
            ],
            "title": "Detail",
            "description": "Spanish message. Input errors from the simulator give an object `{field, message, valid}`; request validation errors give FastAPI's list of `{loc, msg, type}`.",
            "examples": [
              "No existe la corrida: 3f2a9c1b7d4e"
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Error body shared by every agent route."
      },
      "EventIn": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Event type; see `GET /api/v1/sim/catalog` → `events`",
            "examples": [
              "C3_transmission_opening",
              "D1_telemetry_loss"
            ]
          },
          "target": {
            "type": "string",
            "title": "Target",
            "description": "Area (A06), zone (NG), corridor (A06-A07/500), bus B###, line R###, defence function (pdce_zn) or real substation id (SE…)",
            "examples": [
              "A06",
              "B042"
            ]
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params",
            "description": "Overrides of the event's default size (catalog `events[].defaults`)",
            "examples": [
              {}
            ]
          },
          "cause": {
            "type": "string",
            "enum": [
              "intentional",
              "failure"
            ],
            "title": "Cause",
            "description": "Intentional event or plain failure",
            "default": "intentional",
            "examples": [
              "intentional"
            ]
          },
          "cycle": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Cycle",
            "description": "Only in `initial_events`: cycle at which it happens",
            "examples": [
              0
            ]
          }
        },
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "title": "EventIn"
      },
      "ReplayIn": {
        "properties": {
          "policy": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Policy",
            "description": "New policy A, B or C",
            "examples": [
