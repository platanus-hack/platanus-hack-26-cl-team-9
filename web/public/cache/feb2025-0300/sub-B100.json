sitorio de 20 s.","No hay desconexión de generación por frecuencia o tensión (ride-through) salvo la reducción por sobrefrecuencia de solar y eólica.","Despacho y demanda del punto de operación son simulados o modelados (PyPSA-CL), no medidos."],"health":{"kind":"event","scenario":"feb2025-0300","index":0.992,"binding":"supply","mean":0.996,"uncertain":false,"margins":[{"key":"supply","label":"Demanda servida","value":0.992,"raw":0.992,"measured":"67 de 8719 MW perdidos","limit":"0 MW perdidos","source":null,"is_assumption":false,"in_index":true},{"key":"frequency_islands","label":"Frecuencia de las islas","value":1.0,"raw":1.667,"measured":"1 islas evaluadas","limit":"47.5 a 49.0 Hz","source":"NTSyCS art. 3-10 (47,5 Hz) y primer escalón EDAC [4] (49,0 Hz)","is_assumption":false,"in_index":true,"note":"Una isla apagada puntúa 0; el colapso por tensión es una regla, no un cálculo"}],"cut":["R050","R112","R210"],"stages":0,"cost":{"cost_usd":2355720,"unserved_energy_mwh":268.0,"outage_duration_h":{"value":4.0,"is_assumption":true},"voltage_rule":false,"source":"[19] costo de falla CNE, 8,79 US$/kWh (stack.md 6.1)","note":"Valoración regulatoria, no pérdida económica medida. Duración del corte supuesta."}}}