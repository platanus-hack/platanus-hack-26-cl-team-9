lure_cost_usd":35160,"outage_duration_h":{"value":4.0,"is_assumption":true},"load_total_mw":11096,"stages":0,"lines_opened":["R080"],"dark_buses":1,"islands":[{"result":"maintains","min_hz":49.783,"final_hz":49.907,"rocof_hz_s":-0.104,"inertia_mws":34891,"shed_mw":0.0,"battery_mw":0.0,"buses":187},{"result":"blackout","min_hz":50.0,"final_hz":null,"rocof_hz_s":1.971,"inertia_mws":1848,"shed_mw":0.0,"battery_mw":0.0,"reason":"frequency","buses":1}],"prefault_boundary_mw":2209},"assumptions":["Red reducida: una barra por subestación y solo líneas; los transformadores se pliegan en su nodo (no se modelan sus sobrecargas).","Flujo DC: sin pérdidas, sin tensión ni potencia reactiva. La tensión no se calcula: si el corredor del 25F se separa con un flujo previo fuera del rango de validez del esquema de defensa (1.600 MW N→S, 1.000 MW S→N), las islas de ambos extremos colapsan por tensión. Es una regla, no un cálculo, y es el único corredor con límites publicados.","Una línea se abre cuando supera 120% de su capacidad (supuesto de docs/stack.md 4.3). Las protecciones reales dependen de relés y tiempos que no están en los datos.","Cada etapa de la cascada se separa 1,0 s de la anterior (tiempo ilustrativo, no calculado). La etapa siguiente espera a que las islas de la anterior terminen sus EDAC o se apaguen, y empieza 1,0 s después del último de esos eventos.","Reserva primaria 4% de la potencia sincrónica en línea con estatismo 5%, constante de tiempo 3 s y amortiguamiento de carga 1,5 %/Hz: supuestos sin calibrar.","La inercia de cada isla es la de las unidades sincrónicas en línea; solar y eólica no aportan. Una unidad que sale antes del transitorio ya no cuenta.","EDAC con los escalones del informe del CEN sobre el 25F (centro-sur y Norte Grande); los MW de cada escalón se interpolan entre demanda baja y alta. El EDAC por contingencia extrema no se modela.","Una isla que se vuelve a partir parte de nuevo en 50 Hz con la tabla EDAC completa y cuenta como disponible la reserva que ya entregó: puede contar dos veces escalones EDAC y reserva.","Baterías en modo rápido: retardo 200 ms y rampa 300 ms (stack.md 4.5), sin límite de energía en el transitorio de 20 s.","No hay desconexión de generación por frecuencia o tensión (ride-through) salvo la reducción por sobrefrecuencia de solar y eólica.","Despacho y demanda del punto de operación son simulados o modelados (PyPSA-CL), no medidos."],"health":{"kind":"event","scenario":"feb2025-1500","index":0.0,"binding":"frequency_islands","mean":0.5,"uncertain":false,"margins":[{"key":"supply","label":"Demanda servida","value":1.0,"raw":1.0,"measured":"1 de 11096 MW perdidos","limit":"0 MW perdidos","source":null,"is_assumption":false,"in_index":true},{"key":"frequency_islands","label":"Frecuencia de las islas","value":0.0,"raw":0.0,"measured":"2 islas evaluadas","limit":"47.5 a 49.0 Hz","source":"NTSyCS art. 3-10 (47,5 Hz) y primer escalón EDAC [4] (49,0 Hz)","is_assumption":false,"in_index":true,"note":"Una isla apagada puntúa 0; el colapso por tensión es una regla, no un cálculo"}],"cut":["R080"],"stages":0,"cost":{"cost_usd":35160,"unserved_energy_mwh":4.0,"outage_duration_h":{"value":4.0,"is_assumption":true},"voltage_rule":false,"source":"[19] costo de falla CNE, 8,79 US$/kWh (stack.md 6.1)","note":"Valoración regulatoria, no pérdida económica medida. Duración del corte supuesta."}}}