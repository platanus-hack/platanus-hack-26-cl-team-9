lvo la reducción por sobrefrecuencia de solar y eólica.","Despacho y demanda del punto de operación son simulados o modelados (PyPSA-CL), no medidos."],"health":{"kind":"event","scenario":"feb2025-1500","index":0.0,"binding":"supply","mean":0.0,"uncertain":true,"margins":[{"key":"supply","label":"Demanda servida","value":0.0,"raw":0.0,"measured":"11096 de 11096 MW perdidos","limit":"0 MW perdidos","source":null,"is_assumption":false,"in_index":true},{"key":"frequency_islands","label":"Frecuencia de las islas","value":0.0,"raw":0.0,"measured":"colapso por tensión (regla, no calculado)","limit":"47.5 a 49.0 Hz","source":"NTSyCS art. 3-10 (47,5 Hz) y primer escalón EDAC [4] (49,0 Hz)","is_assumption":false,"in_index":true,"note":"Una isla apagada puntúa 0; el colapso por tensión es una regla, no un cálculo"}],"cut":["R239"],"stages":2,"cost":{"cost_usd":390135360,"unserved_energy_mwh":44384.0,"outage_duration_h":{"value":4.0,"is_assumption":true},"voltage_rule":true,"source":"[19] costo de falla CNE, 8,79 US$/kWh (stack.md 6.1)","note":"Valoración regulatoria, no pérdida económica medida. Duración del corte supuesta."}}}